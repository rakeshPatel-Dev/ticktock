# Required for Vercel/production deployments. Create a MongoDB Atlas cluster and
# add this value in Vercel's Project Settings > Environment Variables.
MONGODB_URI=mongodb+srv://your-cluster.mongodb.net

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-auth-secret
# The public base URL of the app in the current environment.
BETTER_AUTH_URL=http://localhost:3000
