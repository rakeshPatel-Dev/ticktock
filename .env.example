# Required for Vercel/production deployments. Create a Turso (libSQL) database
# and add these values in Vercel's Project Settings > Environment Variables.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-auth-secret
# The public base URL of the app in the current environment.
BETTER_AUTH_URL=http://localhost:3000